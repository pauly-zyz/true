# Copy to .env and fill in. .env is git-ignored. Never commit real values.

# Safety switch. Phase 0/1 code never signs transactions regardless, but every
# component also refuses to start unless this is "true".
DRY_RUN=true

# Postgres + TimescaleDB (see docker-compose.yml)
DATABASE_URL=postgres://truebot:true_dev_only@127.0.0.1:5432/truebot

# RPC endpoints per chain. HTTP is used for backfill (eth_getLogs / getSignatures),
# WS for live subscriptions. Use providers that allow multi-day eth_getLogs ranges.
RPC_HTTP_ETHEREUM=
RPC_WS_ETHEREUM=
RPC_HTTP_BASE=
RPC_WS_BASE=
RPC_HTTP_ROBINHOOD= # e.g. the public endpoint https://rpc.mainnet.chain.robinhood.com (rate-limited)
RPC_WS_ROBINHOOD=
RPC_HTTP_BSC=
RPC_WS_BSC=
RPC_HTTP_SOLANA=
RPC_WS_SOLANA=

# Optional: override config file location (default: config/default.yaml)
# TRUE_CONFIG=config/default.yaml
LOG_LEVEL=info

# ---------------- Phase 2: live execution ----------------
# Live trading needs BOTH lines below. Anything else keeps the bot in dry run.
# DRY_RUN=false
# LIVE_CONFIRM=yes

# Bot hot wallets, one per chain, holding small working capital only (never the treasury).
# BOT_PK_<CHAIN> signs; BOT_ADDRESS_<CHAIN> alone allows dry-run simulation without a key.
BOT_PK_BASE=
BOT_PK_BSC=
BOT_PK_ROBINHOOD=
# BOT_ADDRESS_BASE=
# BOT_ADDRESS_BSC=
# BOT_ADDRESS_ROBINHOOD=

# Team alerts and commands (/kill, /resume <slug>, /status) from allowed chats only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# TELEGRAM_ALLOWED_CHAT_IDS=

# Fork tests (pnpm test:fork). Defaults to RPC_HTTP_<CHAIN> when unset. Prefer archive RPCs.
# FORK_RPC_BASE=
# FORK_RPC_BSC=
# FORK_RPC_ROBINHOOD=
